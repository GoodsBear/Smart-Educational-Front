
# 应用端口
VITE_APP_PORT=3000
# 项目名称
VITE_APP_TITLE=vue3-element-admin
# 代理前缀
VITE_APP_BASE_API=/dev-api

# 接口地址VITE_APP_API_URL
 VITE_APP_API_URL= http://localhost:44375
 #http://localhost:44375  # 本地
 #http://8.152.99.73:8080 #阿里云
#VITE_APP_API_URL=http://192.168.48.131:3000    # 虚拟机

# WebSocket 端点（不配置则关闭），线上 ws://api.youlai.tech/ws ，本地 ws://localhost:8989/ws
VITE_APP_WS_ENDPOINT=

# 启用 Mock 服务
VITE_MOCK_DEV_SERVER=false
